# Required
DATABASE_URL=postgresql://user:password@localhost:5432/basecamp_radar
PASSWORD=your-login-password
SECRET_KEY=your-secret-key-for-session-signing
BASECAMP_CLIENT_ID=your-basecamp-oauth-client-id
BASECAMP_CLIENT_SECRET=your-basecamp-oauth-client-secret

# Optional: without a key, tasks are scored on deterministic signals only
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides (example values; see app/config.py for defaults)
BASECAMP_USER_AGENT=Basecamp Radar (you@example.com)
RADAR_CORE_TEAM=Alex
RADAR_TIMEZONE=America/Los_Angeles
